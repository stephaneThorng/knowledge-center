# --- Obsidian ---
# Configuration locale : réglages propres à chaque machine, à ne pas versionner
.obsidian/

# --- Fichiers temporaires / système ---
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.swp
*~

# --- Dossiers hors documentation ---
# music_project est conservé localement (Obsidian) mais pas publié
music_project/

# --- Notes internes (non publiques) ---
# Cahier des charges / notes de travail, conservés localement
IDEA.md

# --- Outils (Quartz, moteur du site) ---
quartz/node_modules/
quartz/public/
.quartz-cache/          # cache de build (a n'importe quel niveau)
quartz/tsconfig.tsbuildinfo
quartz/prof/

# Contenu assemblé au build (généré par .github/workflows/deploy.yml
# ou par ./prepare-content.sh en local) — jamais versionné
quartz/content/
